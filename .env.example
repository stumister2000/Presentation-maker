# Copy to .env.local. Everything is optional: the app runs with none of these.

# Database: leave empty for the built-in database in .data/pglite
DATABASE_URL=

# AI writing with Claude. Without a key, an offline drafting engine is used.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Stock photo search (your own Unsplash app's access key)
UNSPLASH_ACCESS_KEY=

# Only if you deploy and want the daily trash clean-up job
CRON_SECRET=
