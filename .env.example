# Copy to .env.local and fill in. Never commit real values.

# App
APP_URL=http://localhost:3000

# Database: leave empty for embedded Postgres (PGlite) in .data/pglite
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# AI (Claude). Without a key the offline drafting engine is used.
ANTHROPIC_API_KEY=
# AI_ENGINE=claude
# AI_MODEL=claude-opus-5-5

# Stock photos (Unsplash API, your own app's access key)
UNSPLASH_ACCESS_KEY=

# Email (Resend) from your own verified domain
RESEND_API_KEY=
EMAIL_FROM="Deck <hello@yourdomain.com>"

# Google sign-in (your own OAuth client; redirect URI = APP_URL/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_CREDITS_500=

# Vercel Cron shared secret
CRON_SECRET=
